{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel://policy/policy_schema.json",
  "title": "Sentinel Policy Bundle",
  "description": "Structural schema for Sentinel's governance policy_bundle.yaml. Encodes required shape only; business-level rules (weight bounds, required IDs, etc.) are enforced in policy/loader.py.",
  "type": "object",
  "required": [
    "policy",
    "objectives",
    "weights",
    "profile_selection",
    "hard_constraints",
    "authority",
    "escalation",
    "ambiguity",
    "claude",
    "fallback",
    "audit"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "required": ["policy_id", "version", "metadata"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "metadata": {
          "type": "object",
          "required": ["name", "description", "disclaimer"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "disclaimer": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "objectives": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "weights": {
      "type": "object",
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "number" }
          }
        }
      }
    },
    "profile_selection": {
      "type": "object",
      "required": ["rules", "default_profile"],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "profile"],
            "properties": {
              "when": { "type": "object" },
              "profile": { "type": "string", "minLength": 1 }
            }
          }
        },
        "default_profile": { "type": "string", "minLength": 1 }
      }
    },
    "hard_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "enforcement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "enforcement": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object" }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": ["agents"],
      "properties": {
        "agents": {
          "type": "object",
          "minProperties": 1
        },
        "actions_requiring_governance": {
          "type": "array",
          "items": { "type": "string" }
        },
        "actions_requiring_escalation": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "escalation": {
      "type": "object",
      "required": ["outcomes", "thresholds", "conditions"],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "thresholds": { "type": "object" },
        "conditions": { "type": "object" }
      }
    },
    "ambiguity": {
      "type": "object",
      "required": [
        "near_tie_threshold",
        "insufficient_evidence",
        "low_confidence_threshold",
        "conflicting_objectives"
      ],
      "properties": {
        "near_tie_threshold": { "type": "number" },
        "insufficient_evidence": { "type": "object" },
        "low_confidence_threshold": { "type": "number" },
        "conflicting_objectives": { "type": "object" }
      }
    },
    "claude": {
      "type": "object",
      "required": [
        "role",
        "permitted_uses",
        "may_invent_candidates",
        "may_bypass_hard_constraints",
        "may_override_authority",
        "may_directly_execute_actions",
        "invocation_conditions"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "permitted_uses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "may_invent_candidates": { "type": "boolean" },
        "may_bypass_hard_constraints": { "type": "boolean" },
        "may_override_authority": { "type": "boolean" },
        "may_directly_execute_actions": { "type": "boolean" },
        "invocation_conditions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "fallback": {
      "type": "object",
      "required": [
        "on_claude_unavailable",
        "on_invalid_response",
        "on_timeout",
        "on_schema_violation"
      ],
      "properties": {
        "on_claude_unavailable": { "type": "string", "minLength": 1 },
        "on_invalid_response": { "type": "string", "minLength": 1 },
        "on_timeout": { "type": "string", "minLength": 1 },
        "on_schema_violation": { "type": "string", "minLength": 1 }
      }
    },
    "audit": {
      "type": "object",
      "required": ["required_fields"],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
