# Copy this file to .env at the repository root and fill in your own
# Supabase project's values. Never commit the real .env file.
#
# SUPABASE_URL: your Supabase project's REST endpoint.
# SUPABASE_SERVICE_ROLE_KEY: your Supabase project's service-role key.
#   Server-side only -- backend/persistence/connection.py is the only place
#   this is ever read. It must never be exposed to the frontend.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
