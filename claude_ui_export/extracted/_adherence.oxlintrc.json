{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/governance/**",
              "components/navigation/**",
              "components/pipeline/**",
              "components/status/**",
              "components/surfaces/**",
              "ui_kits/control_plane/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentPosition'] > JSXAttribute > JSXIdentifier[name!=/^(?:agent|position|basis|confidence|key|ref|className|style|children)$/]",
        "message": "<AgentPosition> doesn't accept that prop. Declared props: agent, position, basis, confidence."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuditEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|actor|actorKind|message|detail|key|ref|className|style|children)$/]",
        "message": "<AuditEntry> doesn't accept that prop. Declared props: time, actor, actorKind, message, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuditEntry'] > JSXAttribute[name.name='actorKind'] > Literal[value!=/^(?:system|govern|agent|execution|reviewer)$/]",
        "message": "<AuditEntry> actorKind must be one of 'system' | 'govern' | 'agent' | 'execution' | 'reviewer'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mono|style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, mono, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|allowed|escalated|blocked|conflict)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'allowed' | 'escalated' | 'blocked' | 'conflict'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|trailingIcon|loading|fullWidth|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, trailingIcon, loading, fullWidth, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CandidateOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|proposedBy|score|verdict|rationale|rank|selected|style|key|ref|className|style|children)$/]",
        "message": "<CandidateOption> doesn't accept that prop. Declared props: name, proposedBy, score, verdict, rationale, rank, selected, style."
      },
