      {
        "selector": "JSXOpeningElement[name.name='CaseRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|status|agentConflict|surface|amount|time|selected|style|key|ref|className|style|children)$/]",
        "message": "<CaseRow> doesn't accept that prop. Declared props: id, title, status, agentConflict, surface, amount, time, selected, style."
