        "selector": "JSXOpeningElement[name.name='CandidateOption'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:chosen|rejected|considered)$/]",
        "message": "<CandidateOption> verdict must be one of 'chosen' | 'rejected' | 'considered'."
